{
  "modules": {
    "foundation.collections": "Ownership, allocation, collections and generic algorithms; one reusable foundation boundary, not a crate per header.",
    "foundation.text": "Unicode, strings, formatting and lexical conversion.",
    "foundation.math-geometry": "Math, interpolation, geometric primitives, spatial indexing and path search.",
    "foundation.random": "Random generators, noise and weighted sampling; preserve sequences.",
    "foundation.serialization": "JSON, patches, byte encoding and streams.",
    "foundation.compression-crypto": "Compression, checksums, hashes and cryptographic adapters.",
    "foundation.storage": "Files, databases, caching and dynamic libraries.",
    "foundation.runtime": "Threads, time, errors, logging, process/platform support and shared Rust FFI/runtime ownership.",
    "foundation.media": "Images, colors, fonts and audio decoding.",
    "services.http": "HTTP client and trust boundaries.",
    "services.assets": "Asset paths, sources, patching and reload.",
    "services.config-root": "Configuration, Root lifecycle and database/service assembly.",
    "services.scripting": "Lua runtime, conversion, bindings and scripted lifecycle across host layers.",
    "base.geometry": "World wrapping, block traversal and cellular liquid primitives.",
    "base.lighting": "Cellular lighting facade, current Rust implementation and FFI contract.",
    "base.animation": "Shared animated part sets.",
    "presentation.audio": "Mixer, songbook, voice and frontend audio integration.",
    "world.terrain-tiles": "Tiles, materials, terrain selectors, biomes, dungeon generation and world templates.",
    "world.environment": "Liquids, falling blocks, sky, weather, wiring and exposure.",
    "world.celestial": "Celestial coordinates, generation and system-world simulation.",
    "gameplay.entities": "Entity lifecycle, contracts, factory, map and shared game types.",
    "gameplay.movement": "Movement controllers, collision and forces.",
    "gameplay.inventory": "Items, tools, crafting, economy and equipment.",
    "gameplay.objects": "Objects, farming, plants and vehicles.",
    "gameplay.combat": "Damage, projectiles, status and stats.",
    "gameplay.ai": "Behavior, pathfinding, spawning, NPCs, monsters and tenants.",
    "gameplay.player-progression": "Player lifecycle, companions, quests, codex, collections and tech.",
    "sessions.network": "Network elements, deltas, interpolation, packets and authority contracts.",
    "sessions.orchestration": "Universe/world client-server orchestration, travel, teams, chat and permissions.",
    "sessions.persistence": "Player/world persistence and version migration.",
    "presentation.renderer": "GPU resources, world painting, drawables, cameras and visual effects.",
    "presentation.app-platform": "SDL app lifecycle, platform/SDK service contracts and shell integration.",
    "presentation.windowing": "Widgets, layout, input, focus and pane lifecycle.",
    "presentation.frontend": "Frontend screens, dialogs and interaction shells.",
    "tools.release": "Pack/versioned JSON/editor/uploader and release/development scripts.",
    "tools.inactive": "Inactive utilities and archived release scripts; explicit disposition required before retirement.",
    "retained.third-party": "Vendored implementation: retain, replace or audit separately; never count as first-party Rust ports.",
    "validation.tests": "Native unit/integration tests; reference coverage, not production ports.",
    "validation.oracles-harness": "Frozen numerical oracles and actual-behavior laboratory drivers."
  },
